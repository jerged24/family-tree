# Copy to .env and adjust. All values have sane defaults in backend/app/config.py.

# SQLAlchemy database URL. Default is a local SQLite file in the repo root.
DATABASE_URL=sqlite:///./familytree.db

# CORS origins allowed to call the API (comma-separated). Frontend static server:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Echo SQL to stdout (true/false)
SQL_ECHO=false

# Deployment environment: "dev" (default) or "production". In production the app
# refuses to boot with default ADMIN_PASSWORD/SECRET_KEY and sets the Secure cookie flag.
ENV=dev

# Owner password typed to log in. MUST be overridden in production (default "changeme").
ADMIN_PASSWORD=changeme

# Session-cookie signing key. MUST be overridden in production; generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-insecure-secret-change-me

# Directory where uploaded media files are stored.
MEDIA_DIR=./media

# Public base URL of the deployed app (e.g. https://app.up.railway.app).
# Leave blank to derive from the incoming request.
PUBLIC_BASE_URL=
