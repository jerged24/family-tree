# Copy to .env and adjust. All values have sane defaults in backend/app/config.py.

# SQLAlchemy database URL. Default is a local SQLite file in the repo root.
DATABASE_URL=sqlite:///./familytree.db

# CORS origins allowed to call the API (comma-separated). Frontend static server:
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Echo SQL to stdout (true/false)
SQL_ECHO=false
